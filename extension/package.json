{
  "name": "grits-kanban",
  "displayName": "Grits Issue Tracker",
  "description": "Visual Kanban board and issue management for Grits (.jsonl) files",
  "version": "2.4.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/babybirdprd/grits"
  },
  "homepage": "https://github.com/babybirdprd/grits",
  "publisher": "grits",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grits",
          "title": "Grits",
          "icon": "media/grits-icon.svg"
        }
      ]
    },
    "views": {
      "grits": [
        {
          "id": "grits.welcome",
          "name": "Grits Studio",
          "contextualTitle": "Grits Studio",
          "icon": "media/grits-icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "grits.welcome",
        "contents": "Welcome to Grits Studio!\n\n[Open Command Center](command:grits.openDashboard)\n\nThe command center gives you full visibility into agent work, code topology, and project health.",
        "when": "true"
      }
    ],
    "customEditors": [
      {
        "viewType": "grits.issueTracker",
        "displayName": "Grits Kanban",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "**/*.jsonl"
          },
          {
            "filenamePattern": "**/.grits/*.jsonl"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "grits.openDashboard",
        "title": "Grits: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "grits.openKanban",
        "title": "Grits: Open Kanban View"
      },
      {
        "command": "grits.openIssues",
        "title": "Grits: Open Issues",
        "icon": "$(list-flat)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.x",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}