{
  "name": "grits-kanban",
  "displayName": "Grits Issue Tracker",
  "description": "Visual Kanban board and issue management for Grits (.jsonl) files",
  "version": "0.1.0",
  "publisher": "grits",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "grits.issueTracker",
        "displayName": "Grits Kanban",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "**/*.jsonl"
          },
          {
            "filenamePattern": "**/.grits/*.jsonl"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "grits.openKanban",
        "title": "Grits: Open Kanban View"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.x",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}